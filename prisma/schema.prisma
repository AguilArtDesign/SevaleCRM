generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  COMMERCIAL
  LOGISTICS
}

enum Store {
  SERATUS
  PALI
}

enum SyncStatus {
  PENDING
  SYNCED
  OUT_OF_SYNC
  ERROR
}

enum ProductSyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum ProductSyncJobItemStatus {
  PENDING
  SYNCED
  ERROR
}

enum CustomerPersonType {
  PERSON
  COMPANY
}

enum CustomerIntegrationProvider {
  SIIGO
  SERATUS
  PALI
}

enum CustomerIntegrationStatus {
  PENDING
  SYNCED
  ERROR
}

enum OrderSource {
  CRM
  WOOCOMMERCE
}

enum OperationStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum OrderSyncStatus {
  PENDING
  SYNCING
  SYNCED
  ERROR
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSED
  ERROR
}

enum CouponSyncStatus {
  PENDING
  SYNCED
  PARTIAL
  ERROR
}

model User {
  id                     String             @id @default(uuid()) @db.VarChar(36)
  name                   String             @db.VarChar(191)
  email                  String             @unique @db.VarChar(191)
  sellerId               Int?               @unique @map("seller_id")
  emailVerified          Boolean            @default(false) @map("email_verified")
  image                  String?            @db.Text
  role                   Role               @default(COMMERCIAL)
  active                 Boolean            @default(true)
  lastLoginAt            DateTime?          @map("last_login_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  sessions               Session[]
  accounts               Account[]
  notificationReads      NotificationRead[]
  productSyncJobs        ProductSyncJob[]
  orderOperations        OrderOperation[]   @relation("OrderOperationCreatedBy")
  shipmentEvents         ShipmentEvent[]    @relation("ShipmentEventCreatedBy")
  agreementsCreated      Agreement[]        @relation("AgreementCreatedBy")
  agreementComments      AgreementComment[] @relation("AgreementCommentAuthor")
  agreementTasksCreated  AgreementTask[]    @relation("AgreementTaskCreatedBy")
  agreementTasksAssigned AgreementTask[]    @relation("AgreementTaskAssignee")
  prospectsAssigned      Prospect[]         @relation("ProspectAssignee")
  prospectsCreated       Prospect[]         @relation("ProspectCreator")

  @@map("users")
}

model ProductSyncJob {
  id            String               @id @default(uuid()) @db.VarChar(36)
  requestedById String               @map("requested_by_id") @db.VarChar(36)
  status        ProductSyncJobStatus @default(PENDING)
  total         Int
  processed     Int                  @default(0)
  succeeded     Int                  @default(0)
  failed        Int                  @default(0)
  errorMessage  String?              @map("error_message") @db.Text
  createdAt     DateTime             @default(now()) @map("created_at")
  startedAt     DateTime?            @map("started_at")
  completedAt   DateTime?            @map("completed_at")
  requestedBy   User                 @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  items         ProductSyncJobItem[]

  @@index([status, createdAt])
  @@index([requestedById])
  @@map("product_sync_jobs")
}

model ProductSyncJobItem {
  id           Int                      @id @default(autoincrement())
  jobId        String                   @map("job_id") @db.VarChar(36)
  productId    Int                      @map("product_id")
  sku          String                   @db.VarChar(191)
  productName  String                   @map("product_name") @db.VarChar(255)
  store        Store
  wooParentId  BigInt?                  @map("woo_parent_id") @db.UnsignedBigInt
  wooProductId BigInt                   @map("woo_product_id") @db.UnsignedBigInt
  priceCop     Decimal                  @map("price_cop") @db.Decimal(14, 2)
  priceUsd     Decimal                  @map("price_usd") @db.Decimal(14, 2)
  stock        Int
  status       ProductSyncJobItemStatus @default(PENDING)
  attempts     Int                      @default(0)
  errorMessage String?                  @map("error_message") @db.Text
  processedAt  DateTime?                @map("processed_at")
  job          ProductSyncJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, productId])
  @@index([jobId, status])
  @@map("product_sync_job_items")
}

model Customer {
  id                     Int                   @id @default(autoincrement())
  personType             CustomerPersonType    @map("person_type")
  firstName              String?               @map("first_name") @db.VarChar(191)
  lastName               String?               @map("last_name") @db.VarChar(191)
  displayName            String                @map("display_name") @db.VarChar(255)
  company                String?               @db.VarChar(255)
  documentType           String                @map("document_type") @db.VarChar(20)
  documentNumber         String                @map("document_number") @db.VarChar(20)
  checkDigit             String?               @map("check_digit") @db.VarChar(1)
  email                  String?               @db.VarChar(191)
  phone                  String?               @db.VarChar(32)
  country                String?               @db.VarChar(2)
  region                 String?               @db.VarChar(32)
  cityCode               String?               @map("city_code") @db.VarChar(32)
  cityName               String?               @map("city_name") @db.VarChar(191)
  postalCode             String?               @map("postal_code") @db.VarChar(32)
  addressLine1           String?               @map("address_line_1") @db.VarChar(255)
  addressLine2           String?               @map("address_line_2") @db.VarChar(255)
  /// Convenio al que pertenece el cliente. No reemplaza al `agreementId` del prospecto: aquel dice
  /// por qué convenio llegó el prospecto, este a qué convenio sirve el cliente ya creado. Nulo
  /// mientras no se vincule, y `SetNull` para que borrar un convenio no arrastre al cliente.
  agreementId            Int?                  @map("agreement_id")
  vatResponsible         Boolean               @default(false) @map("vat_responsible")
  fiscalResponsibilities Json                  @map("fiscal_responsibilities")
  active                 Boolean               @default(true)
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  deletedAt              DateTime?             @map("deleted_at")
  agreement              Agreement?            @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  integrations           CustomerIntegration[]
  notifications          Notification[]
  orderOperations        OrderOperation[]
  convertedProspects     Prospect[]            @relation("ProspectConvertedCustomer")

  @@unique([documentType, documentNumber])
  @@index([agreementId])
  @@index([documentNumber])
  @@index([email])
  @@index([displayName])
  @@index([country])
  @@index([cityCode])
  @@index([active])
  @@map("customers")
}

model CustomerIntegration {
  id               Int                         @id @default(autoincrement())
  customerId       Int                         @map("customer_id")
  provider         CustomerIntegrationProvider
  externalId       String?                     @map("external_id") @db.VarChar(191)
  externalData     Json?                       @map("external_data")
  status           CustomerIntegrationStatus   @default(PENDING)
  lastAttemptAt    DateTime?                   @map("last_attempt_at")
  lastSyncedAt     DateTime?                   @map("last_synced_at")
  lastErrorCode    String?                     @map("last_error_code") @db.VarChar(100)
  lastErrorMessage String?                     @map("last_error_message") @db.Text
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  customer         Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, provider])
  @@unique([provider, externalId])
  @@index([status])
  @@map("customer_integrations")
}

model Session {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address") @db.VarChar(191)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.VarChar(36)
  userId                String    @map("user_id") @db.VarChar(36)
  issuer                String    @db.VarChar(255)
  accountId             String    @map("account_id") @db.VarChar(191)
  providerId            String    @map("provider_id") @db.VarChar(191)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @db.Text
  idToken               String?   @map("id_token") @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.VarChar(36)
  identifier String   @db.VarChar(191)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

model Product {
  id             Int            @id @default(autoincrement())
  siigoId        String         @unique @map("siigo_id") @db.VarChar(191)
  sku            String         @unique @db.VarChar(191)
  siigoPriceCop  Decimal        @map("siigo_price_cop") @db.Decimal(14, 2)
  siigoPriceUsd  Decimal        @map("siigo_price_usd") @db.Decimal(14, 2)
  siigoStock     Int            @map("siigo_stock")
  store          Store
  wooParentId    BigInt?        @map("woo_parent_id") @db.UnsignedBigInt
  wooVariationId BigInt?        @map("woo_variation_id") @db.UnsignedBigInt
  wooSku         String         @map("woo_sku") @db.VarChar(191)
  wooPriceCop    Decimal        @map("woo_price_cop") @db.Decimal(14, 2)
  wooPriceUsd    Decimal        @map("woo_price_usd") @db.Decimal(14, 2)
  wooStock       Int            @map("woo_stock")
  syncStatus     SyncStatus     @default(PENDING) @map("sync_status")
  lastSyncAt     DateTime?      @map("last_sync_at")
  lastCheckAt    DateTime?      @map("last_check_at")
  productName    String         @map("product_name") @db.VarChar(255)
  imageUrl       String?        @map("image_url") @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  notifications  Notification[]
  orderItems     OrderItem[]

  @@index([store])
  @@index([syncStatus])
  @@index([productName])
  @@map("products")
}

model Coupon {
  id                      Int              @id @default(autoincrement())
  coupon                  String           @unique @db.VarChar(64)
  description             String?          @db.VarChar(255)
  type                    String           @db.VarChar(32)
  amount                  Decimal          @db.Decimal(7, 2)
  dateExpires             DateTime?        @map("date_expires")
  individualUse           Boolean          @default(false) @map("individual_use")
  excludeSaleItems        Boolean          @default(false) @map("exclude_sale_items")
  usageLimit              Int?             @map("usage_limit")
  usageLimitPerUser       Int?             @map("usage_limit_per_user")
  seratusCouponId         Int?             @map("seratus_coupon_id")
  paliCouponId            Int?             @map("pali_coupon_id")
  syncStatus              CouponSyncStatus @default(PENDING) @map("sync_status")
  lastSyncAt              DateTime?        @map("last_sync_at")
  seratusLastErrorCode    String?          @map("seratus_last_error_code") @db.VarChar(100)
  seratusLastErrorMessage String?          @map("seratus_last_error_message") @db.Text
  paliLastErrorCode       String?          @map("pali_last_error_code") @db.VarChar(100)
  paliLastErrorMessage    String?          @map("pali_last_error_message") @db.Text
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  orderOperations         OrderOperation[]

  @@index([type])
  @@index([createdAt])
  @@map("coupons")
}

model IntegrationToken {
  id          Int      @id @default(autoincrement())
  provider    String   @unique @db.VarChar(64)
  accessToken String   @map("access_token") @db.Text
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("integration_tokens")
}

model Notification {
  id                 Int                @id @default(autoincrement())
  type               String             @db.VarChar(100)
  title              String             @db.VarChar(191)
  message            String             @db.Text
  productId          Int?               @map("product_id")
  customerId         Int?               @map("customer_id")
  orderOperationId   Int?               @map("order_operation_id")
  requiredPermission String?            @map("required_permission") @db.VarChar(100)
  createdAt          DateTime           @default(now()) @map("created_at")
  product            Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  customer           Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderOperation     OrderOperation?    @relation(fields: [orderOperationId], references: [id], onDelete: SetNull)
  reads              NotificationRead[]

  @@index([productId])
  @@index([customerId])
  @@index([orderOperationId])
  @@index([requiredPermission])
  @@index([createdAt])
  @@map("notifications")
}

model OrderOperation {
  id                  Int             @id @default(autoincrement())
  operationCode       String          @unique @map("operation_code") @db.VarChar(32)
  source              OrderSource
  status              OperationStatus @default(PENDING)
  customerId          Int             @map("customer_id")
  createdByUserId     String?         @map("created_by_user_id") @db.VarChar(36)
  currency            String          @db.Char(3)
  paymentMethod       String?         @map("payment_method") @db.VarChar(191)
  paymentMethodTitle  String?         @map("payment_method_title") @db.VarChar(191)
  shippingMethod      String?         @map("shipping_method") @db.VarChar(191)
  shippingMethodTitle String?         @map("shipping_method_title") @db.VarChar(191)
  couponId            Int?            @map("coupon_id")
  couponCode          String?         @map("coupon_code") @db.VarChar(64)
  couponType          String?         @map("coupon_type") @db.VarChar(32)
  couponAmount        Decimal?        @map("coupon_amount") @db.Decimal(7, 2)
  subtotal            Decimal         @default(0) @db.Decimal(14, 2)
  discountTotal       Decimal         @default(0) @map("discount_total") @db.Decimal(14, 2)
  shippingTotal       Decimal         @default(0) @map("shipping_total") @db.Decimal(14, 2)
  total               Decimal         @default(0) @db.Decimal(14, 2)
  billingFirstName    String?         @map("billing_first_name") @db.VarChar(191)
  billingLastName     String?         @map("billing_last_name") @db.VarChar(191)
  billingCompany      String?         @map("billing_company") @db.VarChar(255)
  billingAddress1     String?         @map("billing_address_1") @db.VarChar(255)
  billingAddress2     String?         @map("billing_address_2") @db.VarChar(255)
  billingCity         String?         @map("billing_city") @db.VarChar(191)
  billingState        String?         @map("billing_state") @db.VarChar(32)
  billingPostcode     String?         @map("billing_postcode") @db.VarChar(32)
  billingCountry      String?         @map("billing_country") @db.VarChar(2)
  billingEmail        String?         @map("billing_email") @db.VarChar(191)
  billingPhone        String?         @map("billing_phone") @db.VarChar(32)
  shippingFirstName   String?         @map("shipping_first_name") @db.VarChar(191)
  shippingLastName    String?         @map("shipping_last_name") @db.VarChar(191)
  shippingCompany     String?         @map("shipping_company") @db.VarChar(255)
  shippingAddress1    String?         @map("shipping_address_1") @db.VarChar(255)
  shippingAddress2    String?         @map("shipping_address_2") @db.VarChar(255)
  shippingCity        String?         @map("shipping_city") @db.VarChar(191)
  shippingState       String?         @map("shipping_state") @db.VarChar(32)
  shippingPostcode    String?         @map("shipping_postcode") @db.VarChar(32)
  shippingCountry     String?         @map("shipping_country") @db.VarChar(2)
  shippingPhone       String?         @map("shipping_phone") @db.VarChar(32)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  deletedAt           DateTime?       @map("deleted_at")
  customer            Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  coupon              Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  createdBy           User?           @relation("OrderOperationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  orders              Order[]
  shipment            Shipment?
  siigoQuotation      SiigoQuotation?
  notifications       Notification[]

  @@index([customerId])
  @@index([createdByUserId])
  @@index([couponId])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("order_operations")
}

model Order {
  id                   Int                @id @default(autoincrement())
  operationId          Int                @map("operation_id")
  store                Store
  wooOrderId           BigInt?            @map("woo_order_id") @db.UnsignedBigInt
  wooStatus            String?            @map("woo_status") @db.VarChar(50)
  wooCreatedAt         DateTime?          @map("woo_created_at")
  wooUpdatedAt         DateTime?          @map("woo_updated_at")
  syncStatus           OrderSyncStatus    @default(PENDING) @map("sync_status")
  lastSyncAt           DateTime?          @map("last_sync_at")
  lastSyncErrorCode    String?            @map("last_sync_error_code") @db.VarChar(100)
  lastSyncErrorMessage String?            @map("last_sync_error_message") @db.Text
  subtotal             Decimal            @default(0) @db.Decimal(14, 2)
  discountTotal        Decimal            @default(0) @map("discount_total") @db.Decimal(14, 2)
  shippingTotal        Decimal            @default(0) @map("shipping_total") @db.Decimal(14, 2)
  total                Decimal            @default(0) @db.Decimal(14, 2)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  operation            OrderOperation     @relation(fields: [operationId], references: [id], onDelete: Cascade)
  items                OrderItem[]
  coupons              OrderCoupon[]
  webhookDeliveries    WooOrderDelivery[]

  @@unique([operationId, store])
  @@unique([store, wooOrderId])
  @@index([syncStatus])
  @@index([createdAt])
  @@index([wooCreatedAt])
  @@map("orders")
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  productId     Int?     @map("product_id")
  skuSnapshot   String   @map("sku_snapshot") @db.VarChar(191)
  nameSnapshot  String   @map("name_snapshot") @db.VarChar(255)
  storeSnapshot Store    @map("store_snapshot")
  quantity      Int
  originalPrice Decimal? @map("original_price") @db.Decimal(14, 2)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(14, 2)
  priceModified Boolean  @default(false) @map("price_modified")
  subtotal      Decimal  @db.Decimal(14, 2)
  discountTotal Decimal  @default(0) @map("discount_total") @db.Decimal(14, 2)
  total         Decimal  @db.Decimal(14, 2)
  taxClass      String?  @map("tax_class") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([skuSnapshot])
  @@map("order_items")
}

model OrderCoupon {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  code          String   @db.VarChar(191)
  discountTotal Decimal  @default(0) @map("discount_total") @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([code])
  @@map("order_coupons")
}

model Shipment {
  id             Int                 @id @default(autoincrement())
  operationId    Int                 @unique @map("operation_id")
  carrier        String?             @db.VarChar(191)
  trackingNumber String?             @map("tracking_number") @db.VarChar(191)
  status         String?             @db.VarChar(100)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  operation      OrderOperation      @relation(fields: [operationId], references: [id], onDelete: Cascade)
  events         ShipmentEvent[]
  storeSyncs     ShipmentStoreSync[]

  @@index([trackingNumber])
  @@index([status])
  @@map("shipments")
}

model ShipmentStoreSync {
  id                   Int             @id @default(autoincrement())
  shipmentId           Int             @map("shipment_id")
  store                Store
  syncStatus           OrderSyncStatus @default(PENDING) @map("sync_status")
  lastSyncAt           DateTime?       @map("last_sync_at")
  lastSyncErrorCode    String?         @map("last_sync_error_code") @db.VarChar(100)
  lastSyncErrorMessage String?         @map("last_sync_error_message") @db.Text
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  shipment             Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, store])
  @@index([syncStatus])
  @@map("shipment_store_syncs")
}

model ShipmentEvent {
  id              Int      @id @default(autoincrement())
  shipmentId      Int      @map("shipment_id")
  status          String   @db.VarChar(100)
  note            String?  @db.Text
  createdByUserId String?  @map("created_by_user_id") @db.VarChar(36)
  createdAt       DateTime @default(now()) @map("created_at")
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("ShipmentEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([shipmentId, createdAt])
  @@index([createdByUserId])
  @@map("shipment_events")
}

model SiigoQuotation {
  id           Int            @id @default(autoincrement())
  operationId  Int            @unique @map("operation_id")
  externalId   String?        @unique @map("external_id") @db.VarChar(191)
  number       String?        @db.VarChar(100)
  name         String?        @db.VarChar(191)
  url          String?        @db.Text
  sellerId     String?        @map("seller_id") @db.VarChar(191)
  status       String?        @db.VarChar(100)
  syncedAt     DateTime?      @map("synced_at")
  exchangeRate Decimal?       @map("exchange_rate") @db.Decimal(18, 6)
  errorCode    String?        @map("error_code") @db.VarChar(100)
  errorMessage String?        @map("error_message") @db.Text
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  operation    OrderOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("siigo_quotations")
}

model WooOrderDelivery {
  id           Int                   @id @default(autoincrement())
  deliveryId   String                @unique @map("delivery_id") @db.VarChar(191)
  store        Store
  event        String                @db.VarChar(100)
  wooOrderId   BigInt?               @map("woo_order_id") @db.UnsignedBigInt
  orderId      Int?                  @map("order_id")
  status       WebhookDeliveryStatus @default(PENDING)
  processedAt  DateTime?             @map("processed_at")
  errorCode    String?               @map("error_code") @db.VarChar(100)
  errorMessage String?               @map("error_message") @db.Text
  receivedAt   DateTime              @default(now()) @map("received_at")
  order        Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([store, wooOrderId])
  @@index([status, receivedAt])
  @@map("woo_order_deliveries")
}

model NotificationRead {
  notificationId Int          @map("notification_id")
  userId         String       @map("user_id") @db.VarChar(36)
  readAt         DateTime     @default(now()) @map("read_at")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

enum AgreementTaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// Convenio comercial con una empresa. Es una entidad maestra independiente: no es un cliente, no
/// tiene integraciones y nunca se borra. Su ciclo de vida es active = true / false.
model Agreement {
  id              Int       @id @default(autoincrement())
  companyName     String    @map("company_name") @db.VarChar(255)
  nit             String?   @unique @db.VarChar(32)
  /// País con el código ISO 3166-1 alfa-2 del catálogo de Clientes. Los convenios nacieron solo de
  /// Colombia, así que el default conserva ese caso en las filas anteriores y en los alta sin país.
  country         String    @default("CO") @db.VarChar(2)
  // El departamento se guarda con su woocode (CO-ANT) y la ciudad con el código del catálogo
  // (05001) cuando el país tiene catálogo. Fuera de Colombia la ciudad es texto libre y vive en
  // cityName. Los nombres se resuelven al leer, igual que en customers.
  region          String?   @db.VarChar(32)
  cityCode        String?   @map("city_code") @db.VarChar(32)
  cityName        String?   @map("city_name") @db.VarChar(191)
  postalCode      String?   @map("postal_code") @db.VarChar(32)
  addressLine1    String?   @map("address_line_1") @db.VarChar(255)
  addressLine2    String?   @map("address_line_2") @db.VarChar(255)
  contactName     String?   @map("contact_name") @db.VarChar(191)
  contactPosition String?   @map("contact_position") @db.VarChar(191)
  contactEmail    String?   @map("contact_email") @db.VarChar(191)
  contactPhone    String?   @map("contact_phone") @db.VarChar(32)
  /// Logo del convenio. Guarda la URL pública del objeto en R2, no el archivo: el binario vive en el
  /// bucket y aquí solo se referencia, para no inflar la fila ni la base.
  logoUrl         String?   @map("logo_url") @db.Text
  /// Fecha hasta la que el contrato ampara el convenio. Solo fecha, sin hora: se compara por día.
  /// Nula mientras no se conozca la vigencia pactada.
  validUntil      DateTime? @map("valid_until") @db.Date
  description     String?   @db.Text
  active          Boolean   @default(true)
  // Nullable con SetNull para que eliminar un usuario no bloquee ni borre el convenio.
  createdByUserId String?   @map("created_by_user_id") @db.VarChar(36)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdBy User?              @relation("AgreementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  comments  AgreementComment[]
  tasks     AgreementTask[]
  prospects Prospect[]
  customers Customer[]

  @@index([companyName])
  @@index([active])
  @@index([country])
  @@index([region])
  @@index([cityCode])
  @@index([validUntil])
  @@index([createdAt])
  @@map("agreements")
}

/// Historial de lo hablado con la empresa. Inmutable: no se edita ni se elimina, por eso no tiene
/// deletedAt y el módulo no expone PATCH ni DELETE.
model AgreementComment {
  id          Int      @id @default(autoincrement())
  agreementId Int      @map("agreement_id")
  userId      String?  @map("user_id") @db.VarChar(36)
  comment     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  user      User?     @relation("AgreementCommentAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([agreementId, createdAt])
  @@index([userId])
  @@map("agreement_comments")
}

/// Compromiso o actividad del convenio. Se completa o se cancela; nunca se borra.
model AgreementTask {
  id              Int                 @id @default(autoincrement())
  agreementId     Int                 @map("agreement_id")
  title           String              @db.VarChar(255)
  description     String?             @db.Text
  scheduledAt     DateTime            @map("scheduled_at")
  status          AgreementTaskStatus @default(PENDING)
  assignedUserId  String?             @map("assigned_user_id") @db.VarChar(36)
  createdByUserId String?             @map("created_by_user_id") @db.VarChar(36)
  completedAt     DateTime?           @map("completed_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  agreement    Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  assignedUser User?     @relation("AgreementTaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy    User?     @relation("AgreementTaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([agreementId, status])
  @@index([scheduledAt])
  @@index([assignedUserId])
  @@map("agreement_tasks")
}

enum ProspectStatus {
  NEW
  IN_PROGRESS
  QUALIFIED
  CONVERTED
  LOST
}

enum ProspectSource {
  MANUAL
  WHATSAPP
  WEB
  REFERRAL
  OTHER
}

/// Prospecto comercial. Es un dominio aparte de Customer: admite datos incompletos, no tiene
/// integraciones ni pedidos, y solo se convierte cuando el comercial confirma que está completo.
/// Al convertir pasa a CONVERTED y deja de mostrarse en el panel; la fila se conserva como
/// historial de la conversión.
model Prospect {
  id                  Int                 @id @default(autoincrement())
  personType          CustomerPersonType? @map("person_type")
  firstName           String?             @map("first_name") @db.VarChar(191)
  lastName            String?             @map("last_name") @db.VarChar(191)
  displayName         String              @map("display_name") @db.VarChar(255)
  company             String?             @db.VarChar(255)
  documentType        String?             @map("document_type") @db.VarChar(20)
  documentNumber      String?             @map("document_number") @db.VarChar(20)
  checkDigit          String?             @map("check_digit") @db.VarChar(1)
  email               String?             @db.VarChar(191)
  phone               String?             @db.VarChar(32)
  country             String?             @db.VarChar(2)
  // Igual que en customers: Colombia guarda region + cityCode y resuelve el nombre; el exterior
  // guarda cityName con cityCode nulo.
  region              String?             @db.VarChar(32)
  cityCode            String?             @map("city_code") @db.VarChar(32)
  cityName            String?             @map("city_name") @db.VarChar(191)
  postalCode          String?             @map("postal_code") @db.VarChar(32)
  addressLine1        String?             @map("address_line_1") @db.VarChar(255)
  addressLine2        String?             @map("address_line_2") @db.VarChar(255)
  agreementId         Int?                @map("agreement_id")
  source              ProspectSource      @default(MANUAL)
  status              ProspectStatus      @default(NEW)
  // Nullable con SetNull: los usuarios se borran físicamente y eso no debe frenar ni borrar nada.
  assignedUserId      String?             @map("assigned_user_id") @db.VarChar(36)
  // Se pierde el vínculo si el cliente se borra, pero el prospecto sigue marcado como convertido.
  convertedCustomerId Int?                @map("converted_customer_id")
  convertedAt         DateTime?           @map("converted_at")
  createdByUserId     String?             @map("created_by_user_id") @db.VarChar(36)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  agreement         Agreement?    @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  assignedUser      User?         @relation("ProspectAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy         User?         @relation("ProspectCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  convertedCustomer Customer?     @relation("ProspectConvertedCustomer", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  tags              ProspectTag[]

  @@index([displayName])
  @@index([documentNumber])
  @@index([email])
  @@index([status])
  @@index([source])
  @@index([assignedUserId])
  @@index([agreementId])
  @@index([convertedCustomerId])
  @@index([createdAt])
  @@map("prospects")
}

/// Catálogo de etiquetas. `name` es único para que el filtro por etiqueta no se rompa con
/// duplicados que solo difieren en mayúsculas.
model Tag {
  id        Int           @id @default(autoincrement())
  name      String        @unique @db.VarChar(100)
  /// Hex `#RRGGBB` con el que se pinta la etiqueta. Nulo en las creadas antes de existir el campo.
  color     String?       @db.VarChar(7)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  prospects ProspectTag[]

  @@index([active])
  @@map("tags")
}

/// Tabla puente. No tiene valor histórico propio, así que se borra en cascada.
model ProspectTag {
  prospectId Int      @map("prospect_id")
  tagId      Int      @map("tag_id")
  createdAt  DateTime @default(now()) @map("created_at")

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([prospectId, tagId])
  @@index([tagId])
  @@map("prospect_tags")
}
