# APPLICATION
NODE_ENV=production
PORT=3000
TRUST_PROXY=false
FRONTEND_URL=https://crm.example.com
VITE_API_URL=
PRODUCT_IMPORT_ENABLED=false
PROSPECT_IMPORT_ENABLED=false

# CLOUDFLARE R2 (logos de convenios) - opcional; sin estas, la subida queda deshabilitada
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# DATABASE
DATABASE_URL=

# AUTHENTICATION
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://crm.example.com

# INITIAL ADMIN - REMOVE PASSWORD AFTER THE FIRST SEED
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# SIIGO
SIIGO_API_URL=https://api.siigo.com/v1
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=
# Fijos de la cuenta: comprobante de cotización y centro de costo que exige Siigo.
SIIGO_QUOTATION_DOCUMENT_ID=8652
SIIGO_COST_CENTER_ID=1388
# TRM oficial de datos.gov.co, obligatoria solo en las cotizaciones en dólares.
TRM_API_URL=https://www.datos.gov.co/resource/32sa-8pi3.json
# SERATUS
SERATUS_API_URL=https://seratus.com.co/wp-json/wc/v3
WOOCOMMERCE_SERATUS_CK=
WOOCOMMERCE_SERATUS_CS=

# PALI
PALI_API_URL=https://pali.com.co/wp-json/wc/v3
WOOCOMMERCE_PALI_CK=
WOOCOMMERCE_PALI_CS=

# SEVALE CRM ENDPOINT - CUSTOMER LOOKUP BY IDENTIFICATION
WOOCOMMERCE_USERNAME=
SERATUS_PASSWORD=
PALI_PASSWORD=

# GMAIL SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# CLOUDFLARE TURNSTILE - REAL PRODUCTION KEYS
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# N8N
N8N_API_KEY=

# PUNTOS COLOMBIA - PORTAL DE ALIADOS
# Sin estas variables el panel arranca, pero cada llamada responde 503 y no deja operar.
PCO_BASE_URL=https://apinp.puntoscolombia.com
PCO_CLIENT_ID=
PCO_CLIENT_SECRET=
PCO_PARTNER_CODE=
PCO_LOCATION_CODE=
PCO_CA_CHANNEL=V
PCO_REMOTE_IPV4=
PCO_TERMINAL_ID=PCAliados-01
PCO_CASHIER_ID=Yohander-01
PCO_ADMIN_ONLY=true

# REDIS - RESERVED, UNUSED IN V1
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
