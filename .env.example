# APPLICATION
NODE_ENV=development
PORT=3000
TRUST_PROXY=false
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000
PRODUCT_IMPORT_ENABLED=false
PROSPECT_IMPORT_ENABLED=false

# CLOUDFLARE R2 (logos de convenios) - opcional; sin estas, la subida queda deshabilitada
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# DATABASE
DATABASE_URL=

# AUTHENTICATION
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# INITIAL ADMIN
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# SIIGO
SIIGO_API_URL=https://api.siigo.com/v1
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=
# Fijos de la cuenta: comprobante de cotización y centro de costo que exige Siigo.
SIIGO_QUOTATION_DOCUMENT_ID=8652
SIIGO_COST_CENTER_ID=1388
# TRM oficial de datos.gov.co, obligatoria solo en las cotizaciones en dólares.
TRM_API_URL=https://www.datos.gov.co/resource/32sa-8pi3.json
# PUNTOS COLOMBIA
# UAT mientras el proveedor certifica; el paso a produccion es manual y con sus credenciales.
PCO_BASE_URL=https://apinp.puntoscolombia.com
PCO_CLIENT_ID=
PCO_CLIENT_SECRET=
PCO_PARTNER_CODE=901647454
PCO_LOCATION_CODE=PDVBRA0001
PCO_CA_CHANNEL=V
# IPv4 que se informa al proveedor. Hoy es informativa, no autoriza la peticion.
PCO_REMOTE_IPV4=
# Provisional: Puntos Colombia aun no confirma valores por usuario.
PCO_TERMINAL_ID=PCAliados-01
PCO_CASHIER_ID=Yohander-01
# Mientras se certifica, el panel es exclusivo del administrador. false lo abre a los permisos.
PCO_ADMIN_ONLY=true
# SERATUS
SERATUS_API_URL=https://seratus.com.co/wp-json/wc/v3
WOOCOMMERCE_SERATUS_CK=
WOOCOMMERCE_SERATUS_CS=

# PALI
PALI_API_URL=https://pali.com.co/wp-json/wc/v3
WOOCOMMERCE_PALI_CK=
WOOCOMMERCE_PALI_CS=

# SEVALE CRM ENDPOINT - consulta de cliente por identificación
WOOCOMMERCE_USERNAME=
