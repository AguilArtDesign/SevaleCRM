# Local instructions and temporary references
Instruccion no subir a GIT/

# Environment files
.env*
!.env.example
!.env.*.example

# Dependencies and build output
node_modules/
.npm-cache/
.tmp/
dist/
build/
coverage/
.vite/
*.tsbuildinfo

# Logs
# Anclado a la raíz a propósito: sin la barra inicial la regla también ignoraba cualquier
# carpeta `logs` dentro de apps/ o packages/, y un módulo de código con ese nombre se quedaba
# fuera del commit sin avisar.
/logs/
*.log
npm-debug.log*

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Prisma local artifacts
prisma/*.db
prisma/*.db-journal
apps/api/src/generated/prisma/
